# Public browser configuration. These identify the project; they are not user credentials.
VITE_SUPABASE_URL=https://your-project.example
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server secrets. Do not add a VITE_ prefix and do not put values in this file.
