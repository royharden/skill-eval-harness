# Public browser configuration (optional persistence only). These identify the project; they are not user credentials.
VITE_SUPABASE_URL=https://your-project.example
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Function-only secrets (set in the Bolt/Supabase function settings, never with a VITE_ prefix, never here):
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY

# Local runner only (shell environment of the machine running the CLI; never in the browser or this file):
# S20_OUTPUT_ROOT     private run output folder, outside any git repository
# CLAUDE_BIN          real Claude Code executable (not a .cmd/.ps1 shim)
# CODEX_BIN           real Codex executable (not a .cmd/.ps1 shim)
# ANTHROPIC_API_KEY   passed by name to the Claude child only, after authorized activation
# OPENAI_API_KEY      passed by name to the Codex child only, after authorized activation
